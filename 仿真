机器人速度
发布方
//1.包含头文件
#include"rclcpp/rclcpp.hpp"
#include"std_msgs/msg/int32.hpp"
#include<vector>
using namespace std::chrono_literals;

//3.自定义节点类
class speed_publisher:public rclcpp::Node
{
  public:
  speed_publisher():Node("speed_publisher"),count(0)
  {
    RCLCPP_INFO(this->get_logger(),"发布节点创建!");
    //创建消息发布方 (话题名称，消息列表长度)发布对象指针
    publisher_=this->create_publisher<std_msgs::msg::Int32>("robor_speed",10);
    //创建定时器(时间间隔，回调函数)定时器对象指针
    timer_=this->create_wall_timer(1s,std::bind(&speed_publisher::on_timer,this));
    speed_list={2,5,4,8,3,6};
  }
  private:
  void on_timer()
  { //组织并发布消息
    auto message=std_msgs::msg::Int32();
    message.data=speed_list[count];
    RCLCPP_INFO(this->get_logger(),"发布速度为:%d",message.data);
    publisher_->publish(message);
    count++;
    if(count==6)
    {
        count=0;
    }
  }
  rclcpp::Publisher<std_msgs::msg::Int32>::SharedPtr publisher_;
  rclcpp::TimerBase::SharedPtr timer_;
  std::vector<int>speed_list;
  int count; 
};

int main(int argc, char ** argv)
{
  rclcpp::init(argc,argv);
  rclcpp::spin(std::make_shared<speed_publisher>());   
  rclcpp::shutdown();
  return 0;
}

订阅方

//1.包含头文件
#include"rclcpp/rclcpp.hpp"
#include"std_msgs/msg/int32.hpp"

//3.自定义节点类
class speed_monitor:public rclcpp::Node
{
    public:
    speed_monitor():Node("speed_monitor")
    {
        RCLCPP_INFO(this->get_logger(),"订阅方创建");
        //创造订阅方
        subscription_=this->create_subscription<std_msgs::msg::Int32>("robor_speed",10,std::bind(&speed_monitor::do_cb,this,std::placeholders::_1));    
     }
    private:
    void do_cb(const std_msgs::msg::Int32::SharedPtr msg)
    {
        //解析并输出数据
        RCLCPP_INFO(this->get_logger(),"订阅收到的速度：%d",msg->data);
    }
    rclcpp::Subscription<std_msgs::msg::Int32>::SharedPtr subscription_;
};

int main(int argc,char const *argv[])
{
    //2.初始化ros2客户端
    rclcpp::init(argc,argv);    
    //4.调用spin函数，并传入节点对象指针
    rclcpp::spin(std::make_shared<speed_monitor>());
    //5.资源释放
    rclcpp::shutdown();
     return 0;
}

