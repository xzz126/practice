//头文件
//1.包含头文件
#include"rclcpp/rclcpp.hpp"
#include"std_msgs/msg/int32.hpp"
#include<vector>
using namespace std::chrono_literals;

//3.自定义节点类
class speed_publisher01:public rclcpp::Node
{
  public:
  speed_publisher01():Node("speed_publisher01"),count(0)
  {
    RCLCPP_INFO(this->get_logger(),"发布节点创建!");

    //创建消息发布方 (话题名称，消息列表长度)发布对象指针
    publisher_=this->create_publisher<std_msgs::msg::Int32>("speed_topic",10);
    
    //创建定时器(时间间隔，回调函数)定时器对象指针
    timer_=this->create_wall_timer(1s,std::bind(&speed_publisher01::on_timer,this));

    speed_list={2,5,4,8,3};
    
   
  }
  private:
  void on_timer()
  { //组织并发布消息
   
    auto message=std_msgs::msg::Int32();
    message.data=speed_list[count];
    RCLCPP_INFO(this->get_logger(),"发布方发布的消息:%d",message.data);  //转化成c风格字符串
    publisher_->publish(message);
    count++;
    if(count==6)
    {
        count=0;
    }
  }
  rclcpp::Publisher<std_msgs::msg::Int32>::SharedPtr publisher_;
  rclcpp::TimerBase::SharedPtr timer_;
  std::vector<int>speed_list;
  int count; 
};

int main(int argc, char ** argv)
{
  //2.初始化客户端  
  rclcpp::init(argc,argv);
  
  //4.调用spin函数，传入自定义类对象指针
  rclcpp::spin(std::make_shared<speed_publisher01>());
 
  //5.释放资源
  rclcpp::shutdown();
 
  return 0;
}

//订阅方
//1.包含头文件
#include"rclcpp/rclcpp.hpp"
#include"std_msgs/msg/int32.hpp"
#include<vector>

template<class T>
T absoluteDifference(T a,T b)
{
    T difference=a-b;
    return difference>0?difference:-difference;
}

//3.自定义节点类
class speed_monitor01:public rclcpp::Node
{
    public:
    speed_monitor01():Node("speed_monitor01"),old_speed(0),previous_speed(0),count(0)
    {
        RCLCPP_INFO(this->get_logger(),"订阅方创建");
        //创造订阅方
        subscription_=this->create_subscription<std_msgs::msg::Int32>("speed_topic",10,std::bind(&speed_monitor01::do_cb,this,std::placeholders::_1));    
     }
    private:
    void do_cb(const std_msgs::msg::Int32::SharedPtr msg)
    {
        int new_speed=msg->data;
        RCLCPP_INFO(this->get_logger(),"Receive Speed ：%d",msg->data);
        int change=absoluteDifference<int>(previous_speed,old_speed);
        
        RCLCPP_INFO(this->get_logger(),"Processing Speed ：%d",old_speed);
        RCLCPP_INFO(this->get_logger(),"Previous Speed ：%d",previous_speed);      
        RCLCPP_INFO(this->get_logger(),"Speed diference ：%d",change);
        if(change>=3)
        {
            RCLCPP_INFO(this->get_logger(),"State:WARNING");
        }
        else
        {
            RCLCPP_INFO(this->get_logger(),"State:NORMAL");
        }
        v.push_back(change);
        if(v.size()>4)
        {
            v.erase(v.begin());
            if(*v.begin()>=3)
            {
                count-=1;
            }
        }
        for(std::vector<int>::iterator it=v.begin();it!=v.end();it++)
        {
            if(*it>=3)
            {
                count++;
            }
        }
        if(count>=2)
        {
            RCLCPP_INFO(this->get_logger(),"System State:UNSTABLE");
        }
        else
        {
            RCLCPP_INFO(this->get_logger(),"System State:STABLE");
        }
        RCLCPP_INFO(this->get_logger(),"Wating for next command  \n");
        previous_speed=old_speed;
        old_speed=new_speed;
    }
    rclcpp::Subscription<std_msgs::msg::Int32>::SharedPtr subscription_;
    int old_speed;
    int count;
    int previous_speed;
    std::vector<int>v;
    
};

int main(int argc,char const *argv[])
{
    //2.初始化ros2客户端
    rclcpp::init(argc,argv);    
    //4.调用spin函数，并传入节点对象指针
    rclcpp::spin(std::make_shared<speed_monitor01>());
    //5.资源释放
    rclcpp::shutdown();
     return 0;
}
