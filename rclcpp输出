#include"rclcpp/rclcpp.hpp"

int main(int argc,char**argv)
{
    rclcpp::init(argc,argv);//初始化
    auto node=std::make_shared<rclcpp::Node>("cpp_node");//创造节点
    RCLCPP_INFO(node->get_logger(),"你好，c++节点");//打印日志
    rclcpp::spin(node);//运行循环
    rclcpp::shutdown();//关闭
    return 0;
}
